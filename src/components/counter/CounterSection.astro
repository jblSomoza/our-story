---
import Counter from "./Counter.tsx";
---

<section class="counter-section" id="contador">
  <div class="section-header">
    <span class="section-tag">✦ Juntos ✦</span>
    <h2 class="section-title">Nuestro Tiempo</h2>
    <p class="section-desc">Cada segundo contigo es un regalo.</p>
  </div>

  <Counter client:load />
</section>

<style>
  .counter-section {
    position: relative;
    padding: 6rem 2rem 7rem;
    background: linear-gradient(180deg, #060210 0%, #0b0420 50%, #060210 100%);
    overflow: hidden;
  }

  .counter-section::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(245,200,66,0.3), transparent);
  }

  /* linternas decorativas de fondo */
  .counter-section::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 300px 300px at 15% 50%, rgba(245,200,66,0.04) 0%, transparent 70%),
      radial-gradient(ellipse 300px 300px at 85% 50%, rgba(245,200,66,0.04) 0%, transparent 70%);
    pointer-events: none;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-tag {
    font-family: 'Lora', serif;
    font-size: 0.8rem;
    letter-spacing: 0.3em;
    color: #c9a84c;
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.8rem;
    opacity: 0.8;
  }

  .section-title {
    font-family: 'Cinzel Decorative', cursive;
    font-size: clamp(1.8rem, 4vw, 3rem);
    color: #fde68a;
    text-shadow: 0 0 30px rgba(253,230,138,0.3);
    margin-bottom: 0.8rem;
  }

  .section-desc {
    font-family: 'Lora', serif;
    font-style: italic;
    color: #b09060;
    font-size: 1rem;
    opacity: 0.8;
  }
</style>
