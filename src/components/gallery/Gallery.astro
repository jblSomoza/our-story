---
import Slider from "./Slider.tsx";
import { photos } from "../../content/photos";
---

<section class="gallery-section" id="recuerdos">
  <div class="section-header">
    <span class="section-tag">✦ Momentos ✦</span>
    <h2 class="section-title">Nuestros Recuerdos</h2>
    <p class="section-desc">Cada foto, una historia. Cada historia, un tesoro.</p>
  </div>

  <Slider photos={photos} base={import.meta.env.BASE_URL} client:load />
</section>

<style>
  .gallery-section {
    position: relative;
    padding: 6rem 2rem 7rem;
    background: linear-gradient(180deg, #060210 0%, #0a0520 50%, #060210 100%);
    overflow: hidden;
  }

  .gallery-section::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(245,200,66,0.3), transparent);
  }

  .section-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .section-tag {
    font-family: 'Lora', serif;
    font-size: 0.8rem;
    letter-spacing: 0.3em;
    color: #c9a84c;
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.8rem;
    opacity: 0.8;
  }

  .section-title {
    font-family: 'Cinzel Decorative', cursive;
    font-size: clamp(1.8rem, 4vw, 3rem);
    color: #fde68a;
    text-shadow: 0 0 30px rgba(253,230,138,0.3);
    margin-bottom: 0.8rem;
  }

  .section-desc {
    font-family: 'Lora', serif;
    font-style: italic;
    color: #b09060;
    font-size: 1rem;
    opacity: 0.8;
  }
</style>
