---
import LetterCard from "./LetterCard.astro";
import { letters } from "../../content/letters";
---

<section class="letters-section" id="cartas">
  <div class="section-header">
    <span class="section-tag">✦ Para ti ✦</span>
    <h2 class="section-title">Mini Cartas</h2>
    <p class="section-desc">Palabras que guardé en el corazón y hoy te entrego.</p>
  </div>

  <div class="letters-grid">
    {letters.map((letter) => (
      <LetterCard
        title={letter.title}
        body={letter.body}
        date={letter.date}
        from={letter.from}
      />
    ))}
  </div>
</section>

<style>
  .letters-section {
    position: relative;
    padding: 6rem 2rem 8rem;
    background: linear-gradient(180deg, #060210 0%, #0a0318 60%, #060210 100%);
  }

  .letters-section::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(245,200,66,0.3), transparent);
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-tag {
    font-family: 'Lora', serif;
    font-size: 0.8rem;
    letter-spacing: 0.3em;
    color: #c9a84c;
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.8rem;
    opacity: 0.8;
  }

  .section-title {
    font-family: 'Cinzel Decorative', cursive;
    font-size: clamp(1.8rem, 4vw, 3rem);
    color: #fde68a;
    text-shadow: 0 0 30px rgba(253,230,138,0.3);
    margin-bottom: 0.8rem;
  }

  .section-desc {
    font-family: 'Lora', serif;
    font-style: italic;
    color: #b09060;
    font-size: 1rem;
    opacity: 0.8;
  }

  .letters-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2.5rem;
    max-width: 960px;
    margin: 0 auto;
    padding-top: 1rem;
  }
</style>
