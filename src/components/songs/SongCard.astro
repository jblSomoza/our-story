---
interface Props {
  title: string;
  artist: string;
  dedication: string;
  url?: string;
  emoji: string;
}

const { title, artist, dedication, url, emoji } = Astro.props;
---

<article class="song-card">
  <div class="song-inner">
    <div class="song-emoji">{emoji}</div>
    <div class="song-info">
      <h3 class="song-title">{title}</h3>
      <p class="song-artist">{artist}</p>
      <p class="song-dedication">"{dedication}"</p>
    </div>
    {url && (
      <a href={url} target="_blank" rel="noopener noreferrer" class="play-btn" aria-label={`Escuchar ${title}`}>
        <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
          <path d="M8 5v14l11-7z"/>
        </svg>
      </a>
    )}
  </div>
</article>

<style>
  .song-card {
    background: rgba(26,15,46,0.7);
    border: 1px solid rgba(245,200,66,0.15);
    border-radius: 14px;
    backdrop-filter: blur(8px);
    transition: transform 0.3s ease, border-color 0.3s, box-shadow 0.3s;
  }

  .song-card:hover {
    transform: translateY(-4px);
    border-color: rgba(245,200,66,0.35);
    box-shadow: 0 8px 32px rgba(245,200,66,0.08);
  }

  .song-inner {
    display: grid;
    grid-template-columns: 52px 1fr auto;
    gap: 1rem;
    align-items: center;
    padding: 1.4rem 1.4rem 1.4rem 1.2rem;
  }

  .song-emoji {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: radial-gradient(circle, #2a1545, #1a0f2e);
    border: 1px solid rgba(245,200,66,0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    flex-shrink: 0;
    box-shadow: 0 0 12px rgba(245,200,66,0.1);
  }

  .song-info {
    min-width: 0;
  }

  .song-title {
    font-family: 'Cinzel Decorative', cursive;
    font-size: 0.9rem;
    font-weight: 400;
    color: #fde68a;
    margin-bottom: 0.2rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .song-artist {
    font-family: 'Lora', serif;
    font-size: 0.78rem;
    color: #c9a84c;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.6rem;
    opacity: 0.75;
  }

  .song-dedication {
    font-family: 'Lora', serif;
    font-style: italic;
    font-size: 0.88rem;
    color: #c8b08a;
    line-height: 1.6;
  }

  .play-btn {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, #f5c842, #e8a820);
    color: #1a0f2e;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 0 14px rgba(245,200,66,0.3);
  }

  .play-btn:hover {
    transform: scale(1.12);
    box-shadow: 0 0 24px rgba(245,200,66,0.55);
  }

  .play-btn svg {
    margin-left: 2px;
  }

  @media (max-width: 480px) {
    .song-inner {
      grid-template-columns: 44px 1fr;
      grid-template-rows: auto auto;
      align-items: start;
    }

    .song-emoji {
      width: 44px;
      height: 44px;
      font-size: 1.2rem;
      grid-column: 1;
      grid-row: 1;
    }

    .song-info {
      grid-column: 2;
      grid-row: 1;
    }

    .song-title {
      white-space: normal;
      overflow: visible;
      text-overflow: unset;
    }

    .play-btn {
      grid-column: 1 / -1;
      grid-row: 2;
      width: 100%;
      border-radius: 8px;
      height: 36px;
    }
  }
</style>
