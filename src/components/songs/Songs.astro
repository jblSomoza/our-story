---
import SongCard from "./SongCard.astro";
import { songs } from "../../content/songs";
---

<section class="songs-section" id="canciones">
  <div class="section-header">
    <span class="section-tag">✦ Nuestra banda sonora ✦</span>
    <h2 class="section-title">Canciones para Ti</h2>
    <p class="section-desc">Cada melodía guarda un pedacito de lo que siento.</p>
  </div>

  <div class="songs-list">
    {songs.map((song) => (
      <SongCard
        title={song.title}
        artist={song.artist}
        dedication={song.dedication}
        url={song.url}
        emoji={song.emoji}
      />
    ))}
  </div>
</section>

<style>
  .songs-section {
    position: relative;
    padding: 6rem 2rem 8rem;
    background: linear-gradient(180deg, #060210 0%, #090320 50%, #060210 100%);
  }

  .songs-section::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(245,200,66,0.3), transparent);
  }

  .section-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .section-tag {
    font-family: 'Lora', serif;
    font-size: 0.8rem;
    letter-spacing: 0.3em;
    color: #c9a84c;
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.8rem;
    opacity: 0.8;
  }

  .section-title {
    font-family: 'Cinzel Decorative', cursive;
    font-size: clamp(1.8rem, 4vw, 3rem);
    color: #fde68a;
    text-shadow: 0 0 30px rgba(253,230,138,0.3);
    margin-bottom: 0.8rem;
  }

  .section-desc {
    font-family: 'Lora', serif;
    font-style: italic;
    color: #b09060;
    font-size: 1rem;
    opacity: 0.8;
  }

  .songs-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 680px;
    margin: 0 auto;
  }
</style>
