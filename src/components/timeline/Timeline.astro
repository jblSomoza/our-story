---
import TimelineItem from "./TimelineItem.astro";
import { events } from "../../content/timeline";
---

<section class="timeline-section" id="historia">
  <div class="section-header">
    <span class="section-tag">✦ Nuestra historia ✦</span>
    <h2 class="section-title">El Camino Recorrido</h2>
    <p class="section-desc">Cada momento fue un paso hacia donde estamos hoy.</p>
  </div>

  <div class="timeline-wrapper">
    <div class="timeline-line"></div>
    {events.map((event, i) => (
      <TimelineItem
        date={event.date}
        title={event.title}
        description={event.description}
        emoji={event.emoji}
        index={i}
      />
    ))}
  </div>
</section>

<style>
  .timeline-section {
    position: relative;
    padding: 6rem 2rem 7rem;
    background: linear-gradient(180deg, #060210 0%, #08031a 50%, #060210 100%);
  }

  .timeline-section::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(245,200,66,0.3), transparent);
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-tag {
    font-family: 'Lora', serif;
    font-size: 0.8rem;
    letter-spacing: 0.3em;
    color: #c9a84c;
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.8rem;
    opacity: 0.8;
  }

  .section-title {
    font-family: 'Cinzel Decorative', cursive;
    font-size: clamp(1.8rem, 4vw, 3rem);
    color: #fde68a;
    text-shadow: 0 0 30px rgba(253,230,138,0.3);
    margin-bottom: 0.8rem;
  }

  .section-desc {
    font-family: 'Lora', serif;
    font-style: italic;
    color: #b09060;
    font-size: 1rem;
    opacity: 0.8;
  }

  .timeline-wrapper {
    position: relative;
    max-width: 760px;
    margin: 0 auto;
  }

  .timeline-line {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(180deg,
      transparent 0%,
      rgba(245,200,66,0.25) 10%,
      rgba(245,200,66,0.25) 90%,
      transparent 100%
    );
    transform: translateX(-50%);
    z-index: 1;
  }

  @media (max-width: 600px) {
    .timeline-line {
      left: 16px;
    }
  }
</style>
