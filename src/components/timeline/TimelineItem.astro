---
interface Props {
  date: string;
  title: string;
  description: string;
  emoji: string;
  index: number;
}

const { date, title, description, emoji, index } = Astro.props;
const isLeft = index % 2 === 0;
---

<div class={`timeline-item ${isLeft ? 'left' : 'right'}`}>
  <div class="connector">
    <div class="dot">
      <span class="emoji">{emoji}</span>
    </div>
  </div>
  <div class="card">
    <span class="date">{date}</span>
    <h3 class="event-title">{title}</h3>
    <p class="event-desc">{description}</p>
  </div>
</div>

<style>
  .timeline-item {
    display: grid;
    grid-template-columns: 1fr 48px 1fr;
    gap: 0;
    align-items: center;
    margin-bottom: 2.5rem;
  }

  .connector {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .dot {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: radial-gradient(circle, #2a1545, #1a0f2e);
    border: 2px solid rgba(245,200,66,0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 16px rgba(245,200,66,0.2);
    flex-shrink: 0;
  }

  .emoji {
    font-size: 1.2rem;
    line-height: 1;
  }

  .card {
    padding: 1.4rem 1.6rem;
    background: rgba(26,15,46,0.7);
    border: 1px solid rgba(245,200,66,0.15);
    border-radius: 12px;
    backdrop-filter: blur(8px);
    transition: border-color 0.3s, box-shadow 0.3s;
  }

  .card:hover {
    border-color: rgba(245,200,66,0.35);
    box-shadow: 0 4px 24px rgba(245,200,66,0.08);
  }

  .left .card  { grid-column: 1; grid-row: 1; }
  .left .connector { grid-column: 2; grid-row: 1; }
  .left  .card + * { grid-column: 3; } /* empty right side */

  .right .connector { grid-column: 2; grid-row: 1; }
  .right .card { grid-column: 3; grid-row: 1; }

  /* For right-side items, connector is col 2, card is col 3, col 1 is empty */
  .right { }

  .date {
    font-family: 'Lora', serif;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #c9a84c;
    opacity: 0.8;
    display: block;
    margin-bottom: 0.4rem;
  }

  .event-title {
    font-family: 'Cinzel Decorative', cursive;
    font-size: 1rem;
    color: #fde68a;
    margin-bottom: 0.6rem;
    font-weight: 400;
  }

  .event-desc {
    font-family: 'Lora', serif;
    font-style: italic;
    font-size: 0.92rem;
    color: #c8b08a;
    line-height: 1.7;
  }

  @media (max-width: 600px) {
    .timeline-item {
      grid-template-columns: 32px 1fr;
    }

    .left .card, .right .card {
      grid-column: 2;
      grid-row: 1;
    }

    .left .connector, .right .connector {
      grid-column: 1;
      grid-row: 1;
    }

    .dot {
      width: 32px;
      height: 32px;
    }

    .emoji { font-size: 0.9rem; }
  }
</style>
